# Optional. Private RPC endpoints, server-side only (never shipped to the client).
# Without these the app falls back to public RPCs, which are slower and rate-limited.
RPC_URL_MAINNET=
RPC_URL_BASE=
RPC_URL_ARBITRUM=
RPC_URL_OPTIMISM=
RPC_URL_POLYGON=
RPC_URL_AVALANCHE=

# Optional for the read-only demo; required for audit persistence and monitoring.
# Without it decisions return persisted:false; diagnostic logs are not an audit store.
DATABASE_URL=

# Operator secret for /api/cron/monitor, /api/track, /api/webhooks and /api/decisions.
# Header only: Authorization: Bearer <CRON_SECRET>. URL query keys are rejected.
# Vercel Cron sends the header automatically. External schedulers must set it.
CRON_SECRET=

# Optional, dev only. Local Base fork (anvil) for real borrow execution signed by the
# borrower's browser wallet. Unset = the borrow screen stays a read-only preview.
#   anvil --fork-url https://mainnet.base.org --chain-id 31337 --compute-units-per-second 100 --fork-retry-backoff 1000 --retries 10
# Also set RPC_URL_BASE to the same URL so holdings are read from the fork.
NEXT_PUBLIC_FORK_RPC_URL=
# The fork's chain id. Use one that isn't Base's (8453), or wallets show real Base balances
# and refuse network fees.
NEXT_PUBLIC_FORK_CHAIN_ID=31337

# Real borrowing on Base (Morpho), signed by the borrower's own wallet. Off unless "mainnet".
# Keep off until the transaction path has had a security review. Borrows are capped.
NEXT_PUBLIC_EXECUTION=
NEXT_PUBLIC_EXECUTION_CAP_USD=100
